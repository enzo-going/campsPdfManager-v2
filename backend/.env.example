# ============================================================
# CAMPS PDF Manager v2 — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env com credenciais reais.
# ============================================================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development          # Use "production" em produção
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# --- JWT Authentication ---
JWT_SECRET_KEY=troque-por-outra-chave-longa-e-aleatoria
JWT_ACCESS_TOKEN_EXPIRES=1     # Horas
JWT_REFRESH_TOKEN_EXPIRES=30   # Dias

# --- Banco de Dados ---
# SQLite para desenvolvimento. Em produção, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/camps_db
DATABASE_URL=sqlite:///camps.db

# --- Armazenamento de Arquivos ---
UPLOAD_FOLDER=storage/temp
ORIGINALS_FOLDER=storage/originals
PROCESSED_FOLDER=storage/processed
MAX_FILE_SIZE=52428800          # 50MB em bytes

# --- Configurações CAMPS ---
COMPANY_NAME=CAMPS Santos
DEFAULT_LOCATION=Santos, SP, Brasil
ID_PREFIX=CAMPS

# --- Usuário Admin Inicial ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-imediatamente-apos-primeiro-login

# --- DocuSign eSignature API (opcional) ---
SIGNATURE_PROVIDER=docusign
SIGNATURE_API_URL=https://demo.docusign.net/restapi   # Demo. Produção: https://na1.docusign.net/restapi

DOCUSIGN_INTEGRATION_KEY=seu-integration-key-aqui
DOCUSIGN_USER_ID=seu-user-id-aqui
DOCUSIGN_ACCOUNT_ID=seu-account-id-aqui
DOCUSIGN_CLIENT_SECRET=seu-client-secret-aqui
DOCUSIGN_PRIVATE_KEY_PATH=./certs/docusign_private.key
DOCUSIGN_REDIRECT_URI=http://localhost:5000/callback
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# --- Certificado ICP-Brasil A1 (Decreto 10.278/2020) ---
# Coloque o arquivo .pfx na pasta certs/ e informe o caminho e senha.
A1_CERT_PATH=./certs/seu-certificado.pfx
A1_CERT_PASSWORD=senha-do-certificado

# --- CORS e Frontend ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:3000
